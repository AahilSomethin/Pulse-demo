# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MapLibre worker copies, regenerated on install
/public/vendor/

# Raw vessel tracks. Aggregate count summaries live in src/data.
/data/FollowMe/

# Derived passage samples. Cell centres come from a private extract.
# Redistribution is not confirmed, so this stays on the machine that built it.
/data/derived/
